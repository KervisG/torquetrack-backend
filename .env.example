# Variables de entorno del backend. Son todas las que lee `config/settings/`

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production

# Hosts que Django acepta en `Host` y `Origin`. En producción, el dominio público: torquetrackdiesel.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Orígenes con esquema y host que Django acepta en `Origin` y `Referer` para CSRF. En producción, el dominio público: https://torquetrackdiesel.com
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# URL base de la app, usada en correos y PDFs. En producción, el dominio público: https://torquetrackdiesel.com
APP_URL=http://localhost:5173

# Nivel del log raíz (DEBUG, INFO, WARNING, ERROR, CRITICAL). En producción, INFO o WARNING. En desarrollo, DEBUG.
LOG_LEVEL=INFO

# --- HTTPS (solo `prod.py`) -------------------------------------------------------

# Redirige a HTTPS todo request en claro (301). `/api/health/` queda exento
# para que el hosting pueda pingarlo por HTTP.
SECURE_SSL_REDIRECT=true
# HSTS: cuántos segundos recuerda el navegador que el sitio es solo HTTPS
# (un año por defecto). Con 0 no se envía el header.
SECURE_HSTS_SECONDS=31536000
# Extiende HSTS a los subdominios: todos tienen que servir HTTPS.
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# Pide entrar en la lista de precarga de los navegadores. Salir tarda meses:
# activarlo solo cuando el dominio y todos los subdominios son HTTPS para
# siempre.
SECURE_HSTS_PRELOAD=false
# Detrás de un proxy que termina TLS (Cloudflare, balanceador del hosting),
# Django ve HTTP y el redirect entraría en bucle: poner `true` para confiar en
# `X-Forwarded-Proto: https`. Solo si el proxy SIEMPRE escribe ese header y el
# origen no es alcanzable sin pasar por él; si no, cualquiera puede mandarlo.
USE_X_FORWARDED_PROTO=false

# --- Base de datos -------------------------------------------------------------

# Conexión a Postgres; por defecto apunta al servicio `db` de Docker Compose.
DATABASE_URL=postgres://torquetrack:torquetrack@db:5432/torquetrack
DATABASE_SSL=false

# --- Cache compartido ----------------------------------------------------------

# Guarda los contadores de los throttles. Vacío usa `dbcache://django_cache`
# (tabla de Postgres que crea `migrate`), compartido entre workers y
# persistente entre deploys. Para Redis: redis://host:6379/1
CACHE_URL=

# --- IP del cliente (throttles por IP) -----------------------------------------

# Key de `request.META` con la IP real del cliente. Vacío usa `REMOTE_ADDR`.
# Detrás de Cloudflare: CLIENT_IP_HEADER=HTTP_CF_CONNECTING_IP
# ATENCIÓN: usarla solo si el origen acepta tráfico exclusivamente desde
# Cloudflare (allowlist de las IPs de Cloudflare en el firewall o Cloudflare
# Tunnel). Si el origen es alcanzable directo, cualquiera puede mandar ese
# header con una IP inventada y esquivar el rate limit.
CLIENT_IP_HEADER=

# Cuotas de los endpoints públicos de cuenta, en formato `N/periodo`
# (periodos `s`, `m`, `h`, `d`). Los valores de abajo son los por defecto.
LOGIN_THROTTLE_RATE=10/min
LOGIN_ACCOUNT_THROTTLE_RATE=20/hour
REGISTER_THROTTLE_RATE=10/hour
ACTIVATE_THROTTLE_RATE=10/hour
PASSWORD_RESET_THROTTLE_RATE=10/hour
PASSWORD_RESET_ACCOUNT_THROTTLE_RATE=5/hour
PASSWORD_RESET_CONFIRM_THROTTLE_RATE=10/hour
VERIFY_EMAIL_THROTTLE_RATE=20/hour
VERIFY_EMAIL_RESEND_THROTTLE_RATE=5/hour

# --- Correo (Resend) -----------------------------------------------------------

# Sin RESEND_API_KEY, FROM_EMAIL o APP_URL, `prod.py` avisa en el log al
# arrancar: no salen los correos de reset, verificación ni cotizaciones.
RESEND_API_KEY=
FROM_EMAIL=TorqueTrack <no-reply@torquetrackdiesel.com>
# Correo de ventas: recibe el aviso de cada cotización nueva y se muestra en el
# pie de la cotización (página, correo y PDF). Vacío lo omite del pie.
SALES_EMAIL=
REPLY_TO_EMAIL=

# --- Empresa -------------------------------------------------------------------

# Dirección del pie de la cotización, junto a SALES_EMAIL y el dominio de
# APP_URL. Vacío usa `Sarasota, FL`.
COMPANY_ADDRESS=Sarasota, FL

# --- Pagos, impuestos y envíos -------------------------------------------------

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TAXJAR_API_KEY=
# ZIP de origen de los envíos (EasyPost) y del cálculo de impuesto (TaxJar).
# Vacío usa 34241.
SHIP_FROM_ZIP=34241
EASYPOST_API_KEY=
