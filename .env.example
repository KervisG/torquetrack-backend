DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production

# https://torquetrackdiesel.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173
APP_URL=http://localhost:5173

# Base de datos
POSTGRES_DB=torquetrack
POSTGRES_USER=postgres
POSTGRES_PASSWORD=torquetrack
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
DATABASE_SSL=false

# Proxy 
# `true` solo si un proxy que termina TLS siempre escribe `X-Forwarded-Proto`.
USE_X_FORWARDED_PROTO=false
# Proxies delante de Django; 0 usa REMOTE_ADDR. Poner la cantidad real de proxies.
NUM_PROXIES=0
# Key de request.META con la IP del cliente (solo si el origen acepta tráfico únicamente del proxy que la escribe).
CLIENT_IP_HEADER=


# Correo (Resend) 
RESEND_API_KEY=
FROM_EMAIL=TorqueTrack <no-reply@torquetrackdiesel.com>

# Recibe el aviso de cada cotización y aparece en su pie. Vacío lo omite.
SALES_EMAIL=
REPLY_TO_EMAIL=

# Pagos, impuestos y envíos 
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TAXJAR_API_KEY=
EASYPOST_API_KEY=