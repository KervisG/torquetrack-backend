# Backend-only settings. Variable names for the shared integrations
# (Stripe, TaxJar, EasyPost, Resend, RingCentral, DATABASE_URL/DATABASE_SSL)
# are documented in docs/migration/phase-0-infra-env-validation.md and MUST
# match the existing Next.js app exactly since both stacks share one Neon
# Postgres during the strangler migration.
#
# Copy this file to .env before running locally.

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Shared with the existing Next.js app (see docs/migration/phase-0-infra-env-validation.md)
DATABASE_URL=postgres://torquetrack:torquetrack@db:5432/torquetrack
DATABASE_SSL=false
